[global_config]
  always_split_with_profile = True
  title_hide_sizetext = True
  title_transmit_bg_color = "#0076c9"
[keybindings]
[profiles]
  [[default]]
    background_color = "#0d0d0d"
    cursor_color = "#aaaaaa"
    font = JetBrains Mono 12
    foreground_color = "#e0e0e0"
    show_titlebar = False
    scrollbar_position = hidden
    use_system_font = False
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
[plugins]
