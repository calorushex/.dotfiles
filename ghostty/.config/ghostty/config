# Ghostty Configuration

# Shell
shell = /usr/bin/zsh

# Font
font-family = JetBrains Mono
font-size = 12

# Cyberpunk palette
background = #080b12
foreground = #d7faff
selection-background = #193344
selection-foreground = #ffffff
cursor-color = #00ff9c
palette = 0=#080b12
palette = 1=#ff5370
palette = 2=#00ff9c
palette = 3=#f3f99d
palette = 4=#43a5ff
palette = 5=#ff2bd6
palette = 6=#00e5ff
palette = 7=#d7faff
palette = 8=#586174
palette = 9=#ff6e8a
palette = 10=#5dffb3
palette = 11=#ffffa5
palette = 12=#6bb6ff
palette = 13=#ff69df
palette = 14=#5af0ff
palette = 15=#ffffff

# Window
window-padding-x = 8
window-padding-y = 8
window-decoration = true

# Cursor
cursor-style = block
cursor-style-blink = true

# Performance
resize-overlay = never

# Keybindings
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+n=new_window

# Mouse
mouse-hide-while-typing = true

# Miscellaneous
confirm-close-surface = false
